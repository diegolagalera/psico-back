# Base de datos MySQL (En Railway se pueden usar también MYSQL_URL o MYSQLHOST/MYSQLPORT/MYSQLUSER/MYSQLPASSWORD/MYSQLDATABASE)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=psicologia
DB_USER=psicologiauser
DB_PASSWORD=cambia_esta_contraseña_en_produccion

# Opcional: URL directa de conexión (ej. Railway MySQL)
# DATABASE_URL=mysql+pymysql://usuario:password@host:3306/psicologia

# Seguridad JWT y cuenta administradora inicial
JWT_SECRET_KEY=cambia-esta-clave-secreta-en-produccion
ADMIN_DEFAULT_EMAIL=admin@vuelveati.com
ADMIN_DEFAULT_PASSWORD=Admin1234!

# Servidor
FLASK_PORT=5001
FLASK_DEBUG=false
CORS_ORIGINS=*
